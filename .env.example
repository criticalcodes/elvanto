# Copy to `.env` (gitignored) and fill in. Read by `pnpm smoke`; anything already
# set in the environment takes precedence over this file.
#
# The published CLI and MCP server do NOT read this file — they take credentials
# from their own environment, so nothing is picked up implicitly from a directory.

# Elvanto API key — Settings > Account Settings > Secret API Key
ELVANTO_API_KEY=

# Optional: OAuth access token instead of an API key (not yet fully supported)
# ELVANTO_ACCESS_TOKEN=

# Response validation: throw (default) | warn | off
# Use warn or off if Elvanto returns a shape this version does not model yet.
# ELVANTO_VALIDATE=throw

# Diagnostic logging to stderr: on | verbose | off (default off)
# Credentials and returned records are never logged. `verbose` adds parameter
# values, except search terms.
# ELVANTO_DEBUG=on

# Override the API root — mainly for testing against a stub server
# ELVANTO_BASE_URL=https://api.elvanto.com/v1

# MCP server only
# ELVANTO_MCP_PAGE_SIZE=25
# ELVANTO_MCP_MAX_RESPONSE_CHARS=100000
