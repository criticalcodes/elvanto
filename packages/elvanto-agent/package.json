{
  "name": "@criticalcodes/elvanto-agent",
  "version": "0.1.0",
  "description": "Flue agent toolkit for the Elvanto church management API",
  "license": "MIT",
  "homepage": "https://github.com/criticalcodes/elvanto#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/criticalcodes/elvanto.git",
    "directory": "packages/elvanto-agent"
  },
  "bugs": {
    "url": "https://github.com/criticalcodes/elvanto/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "default": "./dist/cli/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "elvanto",
    "church",
    "api",
    "agent",
    "flue",
    "mcp",
    "chms"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "agent": "flue run src/agents/elvanto.ts",
    "dev": "vite dev",
    "build:app": "vite build",
    "build:app:node": "FLUE_TARGET=node vite build",
    "deploy": "vite build && wrangler deploy"
  },
  "dependencies": {
    "@criticalcodes/elvanto": "workspace:*",
    "@hono/node-server": "^2.0.3",
    "valibot": "^1.1.0"
  },
  "peerDependencies": {
    "@flue/runtime": "^2.0.3",
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.39.2",
    "@criticalcodes/elvanto-mcp": "workspace:*",
    "@flue/cli": "^2.0.3",
    "@flue/runtime": "^2.0.3",
    "@flue/vite": "^2.0.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@valibot/to-json-schema": "^1.7.1",
    "hono": "^4.7.0",
    "vite": "^8.0.14",
    "wrangler": "^4.113.0"
  },
  "engines": {
    "node": ">=20"
  }
}
