{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "elvanto-agent",
	"compatibility_date": "2026-06-01",
	"compatibility_flags": ["nodejs_compat"],
	// Workers Traces shows each agent response as a trace with agent-level
	// spans: https://flueframework.com/docs/guide/observability/#cloudflare
	"observability": { "traces": { "enabled": true } },
	// Every agent generates a Durable Object class named after its identity
	// (Elvanto -> FlueElvantoAgent), and Cloudflare requires a migration entry
	// for each one. Append a new tag when you add an agent:
	// https://flueframework.com/docs/guide/cloudflare-target/#managing-migrations
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["FlueElvantoAgent"] }]
	// Secrets are deliberately not listed here. ELVANTO_API_KEY, ELVANTO_MCP_TOKEN
	// and the model provider key are set with `wrangler secret put` — an Elvanto
	// API key reads every member and giving record in the account, so it does not
	// belong in a tracked file.
}
