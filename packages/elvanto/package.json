{
  "name": "@criticalcodes/elvanto",
  "version": "0.1.0",
  "description": "Typed TypeScript client for the Elvanto church management API",
  "license": "MIT",
  "homepage": "https://github.com/criticalcodes/elvanto#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/criticalcodes/elvanto.git",
    "directory": "packages/elvanto"
  },
  "bugs": {
    "url": "https://github.com/criticalcodes/elvanto/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "elvanto",
    "church",
    "api",
    "client",
    "chms"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=20"
  }
}
